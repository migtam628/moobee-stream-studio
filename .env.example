# Only connect to an OBS instance you control. Keep OBS WebSocket authentication enabled.
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
# Local-only by default. Never expose API_PORT without authentication/TLS.
API_HOST=127.0.0.1
API_PORT=8787
# Set true only when OBS is on a trusted separate machine.
ALLOW_REMOTE_OBS=false
