# MooBee Studio local development API. No OBS endpoint or credentials are used.
API_HOST=127.0.0.1
API_PORT=8787
# Optional: persist Node-based web edition scenes outside this process.
# When unset, the default is ~/.moobee-stream-studio
# MOOBEE_DATA_DIR=/absolute/path/to/private/scenes
# Never expose the local scene API directly to the internet without TLS and authentication.
