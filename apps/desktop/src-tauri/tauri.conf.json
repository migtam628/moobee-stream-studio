{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MooBee Stream Studio",
  "version": "0.3.0",
  "identifier": "com.mttechservices.moobeestreamstudio",
  "build": {
    "beforeDevCommand": "npm run dev -w @moobee-live/web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build -w @moobee-live/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MooBee Stream Studio",
        "width": 1480,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 670,
        "center": true,
        "backgroundColor": "#14141e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws: wss: http://127.0.0.1:8788; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Standalone broadcast studio with its own media engine",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
